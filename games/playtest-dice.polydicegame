  "faces": [
    { "id": "fail", "name": "Failure", "weight": 3, "symbol": { "type": "sfSymbol", "name": "xmark" } },
    { "id": "success", "name": "Success", "weight": 2, "symbol": { "type": "sfSymbol", "name": "checkmark" } },
    { "id": "crit", "name": "Critical", "weight": 1, "symbol": { "type": "sfSymbol", "name": "star.fill" } }
  ],
  "diceCount": 4
}